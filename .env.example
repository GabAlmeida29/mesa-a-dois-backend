# --- Servidor ---
PORT=3333
NODE_ENV=development
# Origem(ns) do site, separadas por vírgula (CORS + proteção CSRF por Origin)
CORS_ORIGINS=http://localhost:3000
# Nº de proxies reversos na frente da API (0 em dev; 1 atrás do Caddy/Nginx)
TRUST_PROXY=0

# --- Banco (PostgreSQL) ---
DATABASE_URL=postgresql://mesa:mesa@localhost:5433/mesa_a_dois?schema=public

# --- Sessão / segurança ---
# Sessão em cookie httpOnly; duração máxima em horas
SESSION_TTL_HOURS=12
# false = sessão termina ao fechar o navegador (pede senha + código de novo)
SESSION_PERSISTENT=false
# true = 2FA obrigatório para todos (conta sem 2FA não entra)
REQUIRE_2FA=true
# true = cookie só via HTTPS (__Host-). Padrão: true quando NODE_ENV=production
# COOKIE_SECURE=false
# Bloqueio após N senhas erradas seguidas, por X minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Chave que cifra o segredo do 2FA no banco. Gere com: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Usuários administradores criados pelo seed (npm run seed)
# Em produção a senha precisa de 12+ caracteres e 3 tipos (maiúsc., minúsc., números, símbolos)
SEED_GABRIEL_EMAIL=gabriel@mesaadois.com
SEED_GABRIEL_PASSWORD=troque-esta-senha
SEED_MILENA_EMAIL=milena@mesaadois.com
SEED_MILENA_PASSWORD=troque-esta-senha

# --- Analytics (acessos) ---
# Localização aproximada por IP com a base local DB-IP Lite (usa ~130 MB de RAM)
GEOIP_ENABLED=true
# Dias que os eventos de acesso ficam guardados antes de serem apagados
ANALYTICS_RETENTION_DAYS=395

# --- Armazenamento de imagens ---
# local = salva em ./uploads e serve em /uploads (bom para dev / VPS)
# s3    = qualquer storage S3-compatível (Cloudflare R2, Supabase Storage, Backblaze B2, AWS S3)
STORAGE_DRIVER=local
# Prefixo das URLs de imagens locais (vazio = /uploads/... no mesmo domínio do site)
PUBLIC_BASE_URL=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket (ex.: https://pub-xxxx.r2.dev ou domínio próprio)
S3_PUBLIC_URL=
